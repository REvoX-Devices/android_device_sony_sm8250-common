<?xml version="1.0" encoding="utf-8"?>
<resources>

        <!-- %s is expanded to property_version value. .zip, .delta, .update, .sign extensions added when needed -->
        <string name="filename_base" formatted="false">YAAP-%s-GMS</string>

	<!-- URL base to find .update and .sign files, %s is expanded to property_device value. Path is suffixed by (expanded) filename_base -->
	<string name="url_base_update">https://github.com/realahnet/Releases/releases/download/yaap-sony/</string>

	<!-- URL base to find the full zip files, %s is replaced to be property_device value. -->
	<string name="url_base_full">https://github.com/realahnet/Releases/releases/download/yaap-sony/</string>

	<!-- URL base to find the full zip sha256sum files, %s is replaced to be property_device value. -->
	<string name="url_base_full_sum">https://github.com/realahnet/Releases/releases/download/yaap-sony/</string>

	<!-- URL base to fetch all builds. first %s is replaced by branch name later on by property_device -->
	<string name="url_base_json" formatted="false">https://raw.githubusercontent.com/realahnet/ota-info/%s/%s/%s.json</string>

	<!-- github API url, pointing to the OTA json repo. %s formatted as described above -->
	<string name="url_api_history" formatted="false">https://api.github.com/repos/realahnet/ota-info/commits?sha=%s&amp;path=%s/%s.json</string>

	<!-- URL base to fetch cert jsons. first %s is replaced by branch name second by property_device -->
	<string name="url_cert_json" formatted="false">https://raw.githubusercontent.com/realahnet/ota-info/%s/%s/cert.json</string>

	<!-- Whether device supports A/B performance flashing -->
	<item name="support_ab_perf_mode" type="bool">true</item>
</resources>
